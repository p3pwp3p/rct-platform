# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 절대 커밋 금지)
VANTAGE_EMAIL=your_login_email_here
VANTAGE_PASSWORD=your_password_here

# 카피자(Copiers) 탭 URL — 브라우저 주소창의 그 주소 그대로
VANTAGE_STRATEGY_URL=https://secure.vantagemarkets.com/copyTrading/discover/discoverDetail?strategyId=1289377&tab=2

# 로그인 페이지 (다르면 수정)
VANTAGE_LOGIN_URL=https://secure.vantagemarkets.com/login

# 브라우저를 눈에 보이게 실행하려면 false, 백그라운드면 true
HEADLESS=false

# ── 우리 서버 전송(선택) ─────────────────────────────────────────────
# 값을 넣으면 크롤링 후 import-copiers 로 전송해 잔고 갱신/노드 통제를 수행.
# RCT_API_URL: 로컬은 http://localhost:3000, 배포는 배포 도메인
# RCT_INTERNAL_SECRET: 프로젝트 .env.local 의 INTERNAL_API_SECRET 과 동일 값
# APPLY: false=시뮬레이션(리포트만, 안전), true=실제 정지/재활성 적용
RCT_API_URL=http://localhost:3000
RCT_INTERNAL_SECRET=
APPLY=false
